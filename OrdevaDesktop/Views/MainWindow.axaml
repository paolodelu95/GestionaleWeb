<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="Ordeva.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Ordeva"
        Width="1000" Height="640"
        MinWidth="720" MinHeight="480"
        FontFamily="{StaticResource ContentControlThemeFontFamily}">

    <Grid ColumnDefinitions="220,*">

        <!-- Sidebar di navigazione -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Ordeva"
                           FontSize="20" FontWeight="SemiBold"
                           Margin="16,18,16,12" />
                <ListBox ItemsSource="{Binding Nav}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Icona}"
                                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Titolo}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Contenuto: risolto dal ViewLocator a partire dal ViewModel -->
        <ContentControl Grid.Column="1"
                        Margin="0"
                        Content="{Binding CurrentPage}" />

    </Grid>

</Window>
