<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
             x:Class="Ordeva.Desktop.Views.AliquotaIvaView"
             x:DataType="vm:AliquotaIvaViewModel">

    <Grid RowDefinitions="Auto,*" Margin="24" ColumnDefinitions="*,Auto">

        <!-- ── Intestazione + barra di ricerca + azioni ──────────────────────── -->
        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="12">
            <TextBlock Text="Aliquote IVA" FontSize="24" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="280"
                         Watermark="Cerca per nome, codice, categoria…"
                         Text="{Binding Ricerca}" />
                <Button Content="Nuova" Command="{Binding AggiungiCommand}" />
                <Button Content="Modifica" Command="{Binding ModificaCommand}" />
                <Button Content="Elimina"
                        Command="{Binding EliminaCommand}"
                        Foreground="#dc2626" />
            </StackPanel>
        </StackPanel>

        <!-- ── Lista aliquote ─────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Grid.Column="0" Margin="0,16,0,0"
                BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8">
            <DataGrid ItemsSource="{Binding Aliquote}"
                      SelectedItem="{Binding Selezionata}"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserResizeColumns="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome"
                                        Binding="{Binding Nome}"
                                        Width="2*" />
                    <DataGridTextColumn Header="Aliquota"
                                        Binding="{Binding Valore, StringFormat={}{0}%}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="Codice"
                                        Binding="{Binding Codice}"
                                        Width="Auto" />
                    <DataGridTextColumn Header="Categoria"
                                        Binding="{Binding Categoria}"
                                        Width="2*" />
                    <DataGridCheckBoxColumn Header="Predef."
                                            Binding="{Binding Predefinito}"
                                            Width="Auto" />
                    <DataGridCheckBoxColumn Header="Attiva"
                                            Binding="{Binding Attiva}"
                                            Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── Form di editing (inline) ───────────────────────────────────────── -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                Margin="16,0,0,0" Width="320"
                IsVisible="{Binding InModifica}"
                BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8"
                Background="#f8fafc" Padding="16">
            <ScrollViewer>
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding TitoloForm}"
                               FontSize="18" FontWeight="SemiBold" />

                    <StackPanel Spacing="2">
                        <TextBlock Text="Nome *" Opacity="0.7" />
                        <TextBox Text="{Binding FormNome}"
                                 Watermark="es. Ordinaria, Agevolata…" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Aliquota (%) *" Opacity="0.7" />
                        <NumericUpDown Value="{Binding FormValore}"
                                       Minimum="0" Maximum="100"
                                       Increment="0.5"
                                       FormatString="0.##" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Codice" Opacity="0.7" />
                        <TextBox Text="{Binding FormCodice}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Categoria" Opacity="0.7" />
                        <TextBox Text="{Binding FormCategoria}"
                                 Watermark="es. Imponibile, N4: Esente…" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Natura" Opacity="0.7" />
                        <TextBox Text="{Binding FormNatura}"
                                 Watermark="es. N4, N6.1 (esenzioni)" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Descrizione" Opacity="0.7" />
                        <TextBox Text="{Binding FormDescrizione}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="56" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Note" Opacity="0.7" />
                        <TextBox Text="{Binding FormNote}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="56" />
                    </StackPanel>

                    <CheckBox Content="Predefinita" IsChecked="{Binding FormPredefinito}" />
                    <CheckBox Content="Attiva" IsChecked="{Binding FormAttiva}" />

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Annulla" Command="{Binding AnnullaCommand}" />
                        <Button Content="Salva"
                                Command="{Binding SalvaCommand}"
                                Classes="accent" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
