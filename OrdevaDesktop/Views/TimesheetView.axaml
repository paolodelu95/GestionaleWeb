<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             xmlns:models="clr-namespace:Ordeva.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Ordeva.Desktop.Views.TimesheetView"
             x:DataType="vm:TimesheetViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Intestazione + azioni -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Timesheet · Voci"
                       FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Genera fattura" Command="{Binding GeneraFatturaCommand}" />
                <Button Content="Modifica" Command="{Binding ModificaCommand}" />
                <Button Content="Nuova voce" Command="{Binding AggiungiCommand}"
                        Classes="accent" />
            </StackPanel>
        </Grid>

        <!-- Messaggio di esito/errore -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8"
                Background="#EFF6FF" CornerRadius="8"
                IsVisible="{Binding Messaggio, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Messaggio}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Border>

        <!-- Barra selezione multipla / eliminazione in blocco -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,8"
                Background="#FFF1F2" CornerRadius="8"
                IsVisible="{Binding HasSelezione}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding NumSelezionate, StringFormat='{}{0} selezionate'}" />
                <Button Content="Elimina selezionate" Command="{Binding EliminaCommand}"
                        Foreground="#DC2626" />
            </StackPanel>
        </Border>

        <!-- Ricerca + filtro progetto -->
        <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto">
            <TextBox Grid.Column="0" Watermark="Cerca per progetto, descrizione, utente..."
                     Text="{Binding Ricerca, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="220"
                      PlaceholderText="Tutti i progetti"
                      ItemsSource="{Binding ProgettiFiltro}"
                      SelectedItem="{Binding FiltroProgetto, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Progetto">
                        <TextBlock Text="{Binding Nome}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Margin="8,0,0,0" Content="Azzera filtri"
                    Command="{Binding ResetFiltriCommand}" />
        </Grid>

        <!-- Tabella voci -->
        <Border Grid.Row="4" Margin="0,12,0,0" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Voci}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="Auto" />
                    <DataGridTextColumn Header="Progetto" Binding="{Binding ProgettoNome}" Width="2*" />
                    <DataGridTextColumn Header="Ore"
                                        Binding="{Binding Ore, StringFormat='{}{0:0.##}'}" Width="Auto" />
                    <DataGridTextColumn Header="Descrizione" Binding="{Binding Descrizione}" Width="2*" />
                    <DataGridTextColumn Header="Utente" Binding="{Binding Utente}" Width="*" />
                    <DataGridCheckBoxColumn Header="Fatturata" Binding="{Binding Fatturata}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Riepilogo -->
        <StackPanel Grid.Row="5" Margin="0,12,0,0" Orientation="Horizontal" Spacing="16">
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding Voci.Count, StringFormat='{}{0} voci'}" />
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding OreVisibili, StringFormat='Ore totali: {0:0.##}'}" />
        </StackPanel>
    </Grid>
</UserControl>
