<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             xmlns:models="clr-namespace:Ordeva.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Ordeva.Desktop.Views.ProgettoView"
             x:DataType="vm:ProgettoViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,*">

        <!-- Intestazione + azioni -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Timesheet · Progetti"
                       FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Genera fattura" Command="{Binding GeneraFatturaCommand}" />
                <Button Content="Modifica" Command="{Binding ModificaCommand}" />
                <Button Content="Nuovo progetto" Command="{Binding AggiungiCommand}"
                        Classes="accent" />
            </StackPanel>
        </Grid>

        <!-- Messaggio esito (es. fattura generata / errore) -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8"
                Background="#ECFDF5" CornerRadius="8"
                IsVisible="{Binding Messaggio, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Messaggio}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </Border>

        <TabControl Grid.Row="2" Margin="0,12,0,0">

            <!-- ── Tab Progetti ── -->
            <TabItem Header="Progetti">
                <Grid Margin="0,12,0,0" RowDefinitions="Auto,Auto,*">

                    <!-- Barra selezione multipla / eliminazione in blocco -->
                    <Border Grid.Row="0" Padding="12,8"
                            Background="#FFF1F2" CornerRadius="8"
                            IsVisible="{Binding HasSelezione}">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                       Text="{Binding NumSelezionati, StringFormat='{}{0} selezionati'}" />
                            <Button Content="Elimina selezionati" Command="{Binding EliminaCommand}"
                                    Foreground="#DC2626" />
                        </StackPanel>
                    </Border>

                    <!-- Ricerca + filtro stato -->
                    <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0" Watermark="Cerca progetti..."
                                 Text="{Binding Ricerca, Mode=TwoWay}" />
                        <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="180"
                                  PlaceholderText="Tutti gli stati"
                                  ItemsSource="{Binding Stati}"
                                  SelectedItem="{Binding FiltroStato, Mode=TwoWay}" />
                        <Button Grid.Column="2" Margin="8,0,0,0" Content="Azzera filtri"
                                Command="{Binding ResetFiltriCommand}" />
                    </Grid>

                    <!-- Tabella progetti -->
                    <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="8"
                            BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                        <DataGrid x:Name="GridProgetti"
                                  ItemsSource="{Binding Progetti}"
                                  SelectionMode="Extended"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*" />
                                <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*" />
                                <DataGridTextColumn Header="Stato" Binding="{Binding Stato}" Width="Auto" />
                                <DataGridTextColumn Header="Inizio" Binding="{Binding DataInizio}" Width="Auto" />
                                <DataGridTextColumn Header="Fine" Binding="{Binding DataFine}" Width="Auto" />
                                <DataGridTextColumn Header="Ore tot." Binding="{Binding OreTotali}" Width="Auto" />
                                <DataGridTextColumn Header="Ore fatt." Binding="{Binding OreFatturate}" Width="Auto" />
                                <DataGridTextColumn Header="Da fatt." Binding="{Binding OreDaFatturare}" Width="Auto" />
                                <DataGridTextColumn Header="Tariffa €/h"
                                                    Binding="{Binding TariffaOraria, StringFormat='{}{0:C2}'}" Width="Auto" />
                                <DataGridTextColumn Header="Budget"
                                                    Binding="{Binding Budget, StringFormat='{}{0:C2}'}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── Tab Voci timesheet ── -->
            <TabItem Header="Voci timesheet">
                <Grid Margin="0,12,0,0" RowDefinitions="Auto,*">

                    <!-- Filtro progetto -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Filtra progetto:" VerticalAlignment="Center" />
                        <ComboBox MinWidth="240"
                                  PlaceholderText="Tutti i progetti"
                                  ItemsSource="{Binding Progetti}"
                                  SelectedItem="{Binding FiltroVociProgetto, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Progetto">
                                    <TextBlock Text="{Binding Nome}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Tabella voci -->
                    <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="8"
                            BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding Voci}"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="Auto" />
                                <DataGridTextColumn Header="Progetto" Binding="{Binding ProgettoNome}" Width="*" />
                                <DataGridTextColumn Header="Ore" Binding="{Binding Ore}" Width="Auto" />
                                <DataGridTextColumn Header="Descrizione" Binding="{Binding Descrizione}" Width="2*" />
                                <DataGridTextColumn Header="Utente" Binding="{Binding Utente}" Width="*" />
                                <DataGridCheckBoxColumn Header="Fatturata" Binding="{Binding Fatturata}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
