<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Ordeva.Desktop.Views.PreventivoView"
             x:DataType="vm:PreventivoViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Intestazione + azioni -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Preventivi"
                       FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Modifica" Command="{Binding ModificaCommand}" />
                <Button Content="Nuovo preventivo" Command="{Binding AggiungiCommand}"
                        Classes="accent" />
            </StackPanel>
        </Grid>

        <!-- Barra selezione multipla: stato di massa / eliminazione in blocco -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8"
                Background="#EFF6FF" CornerRadius="8"
                IsVisible="{Binding HasSelezione}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding NumSelezionati, StringFormat='{}{0} selezionati'}" />
                <Button Content="Invia" Command="{Binding BulkInviaCommand}" />
                <Button Content="Accetta" Command="{Binding BulkAccettaCommand}" />
                <Button Content="Rifiuta" Command="{Binding BulkRifiutaCommand}" />
                <Border Width="1" Background="#CBD5E1" Margin="4,2" />
                <Button Content="Elimina selezionati" Command="{Binding EliminaCommand}"
                        Foreground="#DC2626" />
            </StackPanel>
        </Border>

        <!-- Ricerca + filtri (anno / mese / cliente) -->
        <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <TextBox Grid.Column="0" Watermark="Cerca preventivi..."
                     Text="{Binding Ricerca, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="120"
                      PlaceholderText="Anno"
                      ItemsSource="{Binding Anni}"
                      SelectedItem="{Binding FiltroAnno, Mode=TwoWay}" />
            <ComboBox Grid.Column="2" Margin="8,0,0,0" MinWidth="120"
                      PlaceholderText="Mese"
                      ItemsSource="{Binding Mesi}"
                      SelectedValueBinding="{Binding Valore}"
                      SelectedValue="{Binding FiltroMese, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MeseOpzione">
                        <TextBlock Text="{Binding Etichetta}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="3" Margin="8,0,0,0" MinWidth="200"
                      PlaceholderText="Cliente"
                      ItemsSource="{Binding Clienti}"
                      SelectedValueBinding="{Binding Id}"
                      SelectedValue="{Binding FiltroClienteId, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClienteOpzione">
                        <TextBlock Text="{Binding Nome}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="4" Margin="8,0,0,0" Content="Azzera filtri"
                    Command="{Binding ResetFiltriCommand}" />
        </Grid>

        <!-- Tabella preventivi -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Preventivi}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Numero" Binding="{Binding Numero}" Width="Auto" />
                    <DataGridTextColumn Header="Data" Binding="{Binding DataEmissione}" Width="Auto" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="2*" />
                    <DataGridTextColumn Header="Importo"
                                        Binding="{Binding TotaleVisualizzato, StringFormat='{}{0:C2}'}"
                                        Width="*" />
                    <DataGridTextColumn Header="Stato" Binding="{Binding Stato}" Width="*" />
                    <DataGridTextColumn Header="Validità (gg)" Binding="{Binding Validita}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Riga di riepilogo -->
        <TextBlock Grid.Row="4" Margin="0,10,0,0" Foreground="#64748B"
                   Text="{Binding Conteggio, StringFormat='{}{0} documenti'}" />
    </Grid>
</UserControl>
