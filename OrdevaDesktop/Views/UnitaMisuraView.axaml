<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             xmlns:model="clr-namespace:Ordeva.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
             x:Class="Ordeva.Desktop.Views.UnitaMisuraView"
             x:DataType="vm:UnitaMisuraViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Intestazione -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Unità di misura" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Anagrafica di servizio per righe documenti e prodotti."
                       Opacity="0.6" />
        </StackPanel>

        <!-- Barra azioni / ricerca -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0"
                     Watermark="Cerca per nome o simbolo…"
                     Text="{Binding SearchText}" />
            <Button Grid.Column="1" Margin="8,0,0,0"
                    Content="Aggiungi"
                    Command="{Binding AddCommand}" />
            <Button Grid.Column="2" Margin="8,0,0,0"
                    Content="Elimina selezionati"
                    Command="{Binding DeleteSelectedCommand}" />
            <Button Grid.Column="3" Margin="8,0,0,0"
                    Content="Ricarica"
                    Command="{Binding LoadCommand}" />
        </Grid>

        <!-- Lista -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  SelectionMode="Extended"
                  SelectionChanged="OnSelectionChanged"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="True"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome"
                                    Width="*"
                                    Binding="{Binding Nome}" />
                <DataGridTextColumn Header="Simbolo"
                                    Width="180"
                                    Binding="{Binding Simbolo}" />
                <DataGridTemplateColumn Header="Azioni" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="model:UnitaMisura">
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <Button Content="Modifica"
                                        Command="{Binding $parent[DataGrid].((vm:UnitaMisuraViewModel)DataContext).EditCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Elimina"
                                        Foreground="#dc2626"
                                        Command="{Binding $parent[DataGrid].((vm:UnitaMisuraViewModel)DataContext).DeleteCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Form inline (insert/update) -->
        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="16"
                CornerRadius="8"
                Background="{DynamicResource SystemRegionBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                IsVisible="{Binding IsEditing}">
            <Grid ColumnDefinitions="*,*,Auto,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                            Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <TextBlock Text="Dettaglio unità di misura"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status}" Opacity="0.7"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                    <TextBlock Text="Nome" Opacity="0.7" FontSize="12" />
                    <TextBox Text="{Binding FormNome}" Watermark="es. Pezzi" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="0,0,8,0">
                    <TextBlock Text="Simbolo" Opacity="0.7" FontSize="12" />
                    <TextBox Text="{Binding FormSimbolo}" Watermark="es. pz, kg, lt…" />
                </StackPanel>

                <Button Grid.Row="1" Grid.Column="2"
                        Content="Salva"
                        VerticalAlignment="Bottom"
                        Margin="0,0,8,0"
                        Command="{Binding SaveCommand}" />
                <Button Grid.Row="1" Grid.Column="3"
                        Content="Annulla"
                        VerticalAlignment="Bottom"
                        Command="{Binding CancelCommand}" />
            </Grid>
        </Border>

    </Grid>

</UserControl>
