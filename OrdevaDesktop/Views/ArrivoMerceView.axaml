<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Ordeva.Desktop.Views.ArrivoMerceView"
             x:DataType="vm:ArrivoMerceViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*">

        <!-- Intestazione + azioni -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Arrivi merce"
                       FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Modifica" Command="{Binding ModificaCommand}" />
                <Button Content="Nuovo arrivo" Command="{Binding AggiungiCommand}"
                        Classes="accent" />
            </StackPanel>
        </Grid>

        <!-- Barra selezione multipla / azioni in blocco -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8"
                Background="#EFF6FF" CornerRadius="8"
                IsVisible="{Binding HasSelezione}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding NumSelezionati, StringFormat='{}{0} selezionati'}" />
                <Button Content="Conferma ricezione" Command="{Binding ConfermaRicezioneCommand}" />
                <Button Content="Annulla arrivo" Command="{Binding AnnullaCommand}" />
                <Button Content="Elimina selezionati" Command="{Binding EliminaCommand}"
                        Foreground="#DC2626" />
            </StackPanel>
        </Border>

        <!-- Ricerca + filtri -->
        <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBox Grid.Column="0" Watermark="Cerca per numero, fornitore, documento..."
                     Text="{Binding Ricerca, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="120"
                      PlaceholderText="Anno"
                      ItemsSource="{Binding Anni}"
                      SelectedItem="{Binding FiltroAnno, Mode=TwoWay}" />
            <ComboBox Grid.Column="2" Margin="8,0,0,0" MinWidth="200"
                      PlaceholderText="Tutti i fornitori"
                      ItemsSource="{Binding Fornitori}"
                      SelectedItem="{Binding FiltroFornitore, Mode=TwoWay}" />
            <Button Grid.Column="3" Margin="8,0,0,0" Content="Azzera filtri"
                    Command="{Binding ResetFiltriCommand}" />
        </Grid>

        <!-- Tabella arrivi -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Arrivi}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Numero" Binding="{Binding Numero}" Width="Auto" />
                    <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="Auto" />
                    <DataGridTextColumn Header="Fornitore" Binding="{Binding FornitoreVisualizzato}" Width="2*" />
                    <DataGridTextColumn Header="Doc. fornitore" Binding="{Binding NumeroDocumentoFornitore}" Width="*" />
                    <DataGridTextColumn Header="Totale" Width="*"
                                        Binding="{Binding Totale, StringFormat='{}{0:C2}'}" />
                    <DataGridTextColumn Header="Stato" Binding="{Binding StatoLabel}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
