<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Ordeva.Desktop.Views.EcommerceView"
             x:DataType="vm:EcommerceViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*">

        <!-- Intestazione + azioni -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="E-commerce"
                       FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Modifica" Command="{Binding ModificaCommand}" />
                <Button Content="Nuova configurazione" Command="{Binding AggiungiCommand}"
                        Classes="accent" />
            </StackPanel>
        </Grid>

        <!-- Barra selezione multipla / eliminazione in blocco -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8"
                Background="#FFF1F2" CornerRadius="8"
                IsVisible="{Binding HasSelezione}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding NumSelezionati, StringFormat='{}{0} selezionati'}" />
                <Button Content="Elimina selezionati" Command="{Binding EliminaCommand}"
                        Foreground="#DC2626" />
            </StackPanel>
        </Border>

        <!-- Ricerca + filtri -->
        <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBox Grid.Column="0" Watermark="Cerca configurazioni..."
                     Text="{Binding Ricerca, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="180"
                      PlaceholderText="Tutti i provider"
                      ItemsSource="{Binding Providers}"
                      SelectedItem="{Binding FiltroProvider, Mode=TwoWay}" />
            <ToggleButton Grid.Column="2" Margin="8,0,0,0" Content="Solo attive"
                          IsChecked="{Binding FiltroSoloAttive, Mode=TwoWay}" />
            <Button Grid.Column="3" Margin="8,0,0,0" Content="Azzera filtri"
                    Command="{Binding ResetFiltriCommand}" />
        </Grid>

        <!-- Tabella configurazioni -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Configs}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderLabel}" Width="Auto" />
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*" />
                    <DataGridTextColumn Header="Base URL" Binding="{Binding BaseUrl}" Width="2*" />
                    <DataGridCheckBoxColumn Header="Attivo" Binding="{Binding Attivo}" Width="Auto" />
                    <DataGridCheckBoxColumn Header="Credenziali" Binding="{Binding HaCredenziali}" Width="Auto" />
                    <DataGridTextColumn Header="Ultima sync" Binding="{Binding LastSync}" Width="*" />
                    <DataGridTextColumn Header="Creata" Binding="{Binding CreatedAt}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
