<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             xmlns:models="clr-namespace:Ordeva.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="620"
             x:Class="Ordeva.Desktop.Views.UtenteView"
             x:DataType="vm:UtenteViewModel">

    <Grid ColumnDefinitions="*,Auto">

        <!-- ── Colonna principale: lista ──────────────────────────────────── -->
        <DockPanel Grid.Column="0" Margin="24">

            <!-- Intestazione -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Utenti" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Gestione degli utenti dell'applicazione (multi-utente)."
                               Opacity="0.6" FontSize="13" />
                </StackPanel>
                <Button Grid.Column="1" Content="Nuovo utente"
                        Command="{Binding AggiungiCommand}"
                        VerticalAlignment="Center"
                        Classes="accent" />
            </Grid>

            <!-- Barra ricerca / filtri -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
                <TextBox Grid.Column="0"
                         Text="{Binding Ricerca}"
                         Watermark="Cerca per username, nome o email…"
                         MaxWidth="360" HorizontalAlignment="Left" />
                <ComboBox Grid.Column="1" MinWidth="160" Margin="12,0,0,0"
                          PlaceholderText="Tutti i ruoli"
                          ItemsSource="{Binding RuoliFiltro}"
                          SelectedItem="{Binding FiltroRuolo}" />
                <CheckBox Grid.Column="2" Content="Solo attivi"
                          IsChecked="{Binding SoloAttivi}"
                          VerticalAlignment="Center" Margin="12,0" />
                <Button Grid.Column="3" Content="Ricarica"
                        Command="{Binding LoadCommand}"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- Barra azioni di blocco (solo con selezione) -->
            <Border DockPanel.Dock="Top"
                    IsVisible="{Binding EliminaSelezionatiCommand.CanExecute}"
                    Background="#FFF1F0" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding NumeroSelezionati, StringFormat='{}{0} selezionati'}" />
                    <Button Content="Elimina selezionati"
                            Command="{Binding EliminaSelezionatiCommand}"
                            Foreground="#DC2626" />
                </StackPanel>
            </Border>

            <!-- Tabella -->
            <DataGrid Name="Griglia"
                      ItemsSource="{Binding Items}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="6">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Width="*"
                                        Binding="{Binding Username}" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Nome" Width="*"
                                        Binding="{Binding Nome}" />
                    <DataGridTextColumn Header="Email" Width="*"
                                        Binding="{Binding Email}" />
                    <DataGridTextColumn Header="Ruolo" Width="Auto"
                                        Binding="{Binding RuoloLabel}" />
                    <DataGridCheckBoxColumn Header="Attivo" Width="80"
                                            Binding="{Binding Attivo}" />
                    <DataGridTemplateColumn Header="" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Utente">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <Button Content="Modifica"
                                            Command="{Binding $parent[DataGrid].((vm:UtenteViewModel)DataContext).ModificaCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Elimina"
                                            Foreground="#DC2626"
                                            Command="{Binding $parent[DataGrid].((vm:UtenteViewModel)DataContext).EliminaCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- ── Pannello editor laterale ───────────────────────────────────── -->
        <Border Grid.Column="1"
                IsVisible="{Binding EditorAperto}"
                Width="380"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Margin="24" Spacing="14">
                    <TextBlock Text="{Binding TitoloEditor}"
                               FontSize="18" FontWeight="Bold" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Username *" FontWeight="SemiBold" FontSize="13" />
                        <TextBox Text="{Binding EditUsername}"
                                 Watermark="es. mario.rossi" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding PasswordLabel}" FontWeight="SemiBold" FontSize="13" />
                        <TextBox Text="{Binding EditPassword}"
                                 PasswordChar="•" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Nome" FontWeight="SemiBold" FontSize="13" />
                        <TextBox Text="{Binding EditNome}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Email" FontWeight="SemiBold" FontSize="13" />
                        <TextBox Text="{Binding EditEmail}" Watermark="nome@dominio.it" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Ruolo" FontWeight="SemiBold" FontSize="13" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Ruoli}"
                                  SelectedItem="{Binding EditRuolo}" />
                    </StackPanel>

                    <CheckBox Content="Attivo" IsChecked="{Binding EditAttivo}" />

                    <TextBlock IsVisible="{Binding HasErrore}"
                               Text="{Binding ErroreEditor}"
                               Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Annulla" Command="{Binding AnnullaCommand}" />
                        <Button Content="Salva" Classes="accent"
                                Command="{Binding SalvaCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
