<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Ordeva.Desktop.Views.FatturaRicorrenteView"
             x:DataType="vm:FatturaRicorrenteViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*">

        <!-- Intestazione + azioni -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Fatture ricorrenti"
                       FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Emetti ora" Command="{Binding EmettiCommand}" />
                <Button Content="Attiva/Disattiva" Command="{Binding Attiva_DisattivaCommand}" />
                <Button Content="Modifica" Command="{Binding ModificaCommand}" />
                <Button Content="Nuova ricorrente" Command="{Binding AggiungiCommand}"
                        Classes="accent" />
            </StackPanel>
        </Grid>

        <!-- Barra selezione multipla / eliminazione in blocco -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8"
                Background="#FFF1F2" CornerRadius="8"
                IsVisible="{Binding HasSelezione}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding NumSelezionati, StringFormat='{}{0} selezionati'}" />
                <Button Content="Elimina selezionati" Command="{Binding EliminaCommand}"
                        Foreground="#DC2626" />
            </StackPanel>
        </Border>

        <!-- Ricerca + filtri -->
        <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto">
            <TextBox Grid.Column="0" Watermark="Cerca ricorrenti..."
                     Text="{Binding Ricerca, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="160"
                      ItemsSource="{Binding FiltriStato}"
                      SelectedItem="{Binding FiltroStato, Mode=TwoWay}" />
            <Button Grid.Column="2" Margin="8,0,0,0" Content="Azzera filtri"
                    Command="{Binding ResetFiltriCommand}" />
        </Grid>

        <!-- Tabella ricorrenti -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Ricorrenti}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="2*" />
                    <DataGridTextColumn Header="Descrizione" Binding="{Binding Descrizione}" Width="2*" />
                    <DataGridTextColumn Header="Frequenza" Binding="{Binding FrequenzaLabel}" Width="*" />
                    <DataGridTextColumn Header="Giorno" Binding="{Binding GiornoEmissione}" Width="Auto" />
                    <DataGridTextColumn Header="Prossima emissione"
                                        Binding="{Binding ProssimaEmissione}" Width="Auto" />
                    <DataGridCheckBoxColumn Header="Attiva" Binding="{Binding Attiva}" Width="Auto" />
                    <DataGridCheckBoxColumn Header="Scaduta" Binding="{Binding IsScaduta}" Width="Auto" />
                    <DataGridTextColumn Header="Totale"
                                        Binding="{Binding Totale, StringFormat='{}{0:C2}'}" Width="Auto" />
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
