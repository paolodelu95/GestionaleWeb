<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Ordeva.Desktop.Views.AcquistoView"
             x:DataType="vm:AcquistoViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Intestazione + azioni -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Acquisti" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
                <Border Background="#FEF3C7" CornerRadius="12" Padding="10,4" VerticalAlignment="Center"
                        IsVisible="{Binding HasDaPagare}">
                    <TextBlock VerticalAlignment="Center" Foreground="#92400E"
                               Text="{Binding DaPagareCount, StringFormat='{}{0} da pagare'}" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Modifica" Command="{Binding ModificaCommand}" />
                <Button Content="Registra acquisto" Command="{Binding AggiungiCommand}" Classes="accent" />
            </StackPanel>
        </Grid>

        <!-- Barra selezione multipla / azioni in blocco -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8"
                Background="#FFF1F2" CornerRadius="8"
                IsVisible="{Binding HasSelezione}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding NumSelezionati, StringFormat='{}{0} selezionati'}" />
                <Button Content="Segna pagati" Command="{Binding SegnaPagatiCommand}" />
                <Button Content="Annulla" Command="{Binding SegnaAnnullatiCommand}" />
                <Button Content="Elimina selezionati" Command="{Binding EliminaCommand}"
                        Foreground="#DC2626" />
            </StackPanel>
        </Border>

        <!-- Ricerca + filtri -->
        <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <TextBox Grid.Column="0" Watermark="Cerca per numero, fornitore o note..."
                     Text="{Binding Ricerca, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="140"
                      PlaceholderText="Tutti gli anni"
                      ItemsSource="{Binding Anni}"
                      SelectedItem="{Binding FiltroAnno, Mode=TwoWay}" />
            <ComboBox Grid.Column="2" Margin="8,0,0,0" MinWidth="180"
                      PlaceholderText="Tutti i fornitori"
                      ItemsSource="{Binding Fornitori}"
                      SelectedItem="{Binding FiltroFornitore, Mode=TwoWay}" />
            <ComboBox Grid.Column="3" Margin="8,0,0,0" MinWidth="160"
                      PlaceholderText="Tutti gli stati"
                      ItemsSource="{Binding Stati}"
                      SelectedItem="{Binding FiltroStato, Mode=TwoWay}" />
            <Button Grid.Column="4" Margin="8,0,0,0" Content="Azzera filtri"
                    Command="{Binding ResetFiltriCommand}" />
        </Grid>

        <!-- Tabella acquisti -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Acquisti}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Numero" Binding="{Binding Numero}" Width="Auto" />
                    <DataGridTextColumn Header="Data" Binding="{Binding DataEmissione}" Width="Auto" />
                    <DataGridTextColumn Header="Fornitore" Binding="{Binding FornitoreNome}" Width="2*" />
                    <DataGridTextColumn Header="Pagamento" Binding="{Binding TipoPagamentoNome}" Width="*" />
                    <DataGridTextColumn Header="Imponibile"
                                        Binding="{Binding ImponibileVisualizzato, StringFormat='{}{0:C2}'}" Width="Auto" />
                    <DataGridTextColumn Header="Totale"
                                        Binding="{Binding TotaleVisualizzato, StringFormat='{}{0:C2}'}" Width="Auto" />
                    <DataGridTextColumn Header="Stato" Binding="{Binding Stato}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Riepilogo totali della selezione visibile -->
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="12,8"
                Background="#F1F5F9" CornerRadius="8" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Totale visibile:" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotaleVisibile, StringFormat='{}{0:C2}'}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
