<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             xmlns:models="clr-namespace:Ordeva.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Ordeva.Desktop.Views.CrmView"
             x:DataType="vm:CrmViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Intestazione + azioni -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="CRM · Pipeline opportunità"
                       FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Modifica" Command="{Binding ModificaCommand}" />
                <Button Content="Nuova opportunità" Command="{Binding AggiungiCommand}"
                        Classes="accent" />
            </StackPanel>
        </Grid>

        <!-- Barra selezione multipla / eliminazione in blocco -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8"
                Background="#FFF1F2" CornerRadius="8"
                IsVisible="{Binding HasSelezione}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding NumSelezionati, StringFormat='{}{0} selezionati'}" />
                <Button Content="Elimina selezionati" Command="{Binding EliminaCommand}"
                        Foreground="#DC2626" />
            </StackPanel>
        </Border>

        <!-- Ricerca + filtro stage -->
        <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto">
            <TextBox Grid.Column="0" Watermark="Cerca opportunità..."
                     Text="{Binding Ricerca, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="200"
                      PlaceholderText="Tutti gli stage"
                      ItemsSource="{Binding StagesFiltro}"
                      SelectedItem="{Binding FiltroStage, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:CrmStage">
                        <TextBlock Text="{Binding Nome}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Margin="8,0,0,0" Content="Azzera filtri"
                    Command="{Binding ResetFiltriCommand}" />
        </Grid>

        <!-- Tabella opportunità -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Opportunita}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                    <DataGridTextColumn Header="Titolo" Binding="{Binding Titolo}" Width="2*" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*" />
                    <DataGridTextColumn Header="Stage" Binding="{Binding StageNome}" Width="*" />
                    <DataGridTextColumn Header="Contatto" Binding="{Binding Contatto}" Width="*" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                    <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="Auto" />
                    <DataGridTextColumn Header="Valore"
                                        Binding="{Binding Valore, StringFormat='{}{0:C2}'}" Width="Auto" />
                    <DataGridTextColumn Header="Prob."
                                        Binding="{Binding Probabilita, StringFormat='{}{0}%'}" Width="Auto" />
                    <DataGridTextColumn Header="Data prevista" Binding="{Binding DataPrevista}" Width="Auto" />
                    <DataGridTextColumn Header="Assegnatario" Binding="{Binding Assegnatario}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Riepilogo -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0" Orientation="Horizontal" Spacing="16">
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding Opportunita.Count, StringFormat='{}{0} opportunità'}" />
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding TotaleVisibile, StringFormat='Totale: {0:C2}'}" />
        </StackPanel>
    </Grid>
</UserControl>
