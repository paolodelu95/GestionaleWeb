<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             xmlns:models="clr-namespace:Ordeva.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
             x:Class="Ordeva.Desktop.Views.CategoriaProdottoView"
             x:DataType="vm:CategoriaProdottoViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,*">

        <!-- Intestazione -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Categorie prodotto" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Categorie merceologiche e IVA predefinita dei prodotti."
                           Opacity="0.6" FontSize="13" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Nuova categoria"
                    Command="{Binding AggiungiCommand}"
                    VerticalAlignment="Center"
                    Classes="accent" />
        </Grid>

        <!-- Barra di ricerca + azioni di gruppo -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0"
                     Text="{Binding Ricerca}"
                     Watermark="Cerca per nome…"
                     MaxWidth="340" HorizontalAlignment="Left" />

            <Button Grid.Column="1" Content="Modifica"
                    Command="{Binding ModificaCommand}" Margin="8,0,0,0" />
            <Button Grid.Column="2" Content="Elimina"
                    Command="{Binding EliminaCommand}" Margin="8,0,0,0" />
            <Button Grid.Column="3" Content="Elimina selezionate"
                    Command="{Binding EliminaSelezionateCommand}" Margin="8,0,0,0" />
        </Grid>

        <!-- Griglia -->
        <DataGrid Grid.Row="2"
                  Name="Griglia"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding Selezionata}"
                  SelectionMode="Extended"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1" BorderBrush="#22000000"
                  CornerRadius="6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome"
                                    Binding="{Binding Nome}"
                                    Width="*" />
                <DataGridTextColumn Header="IVA predefinita"
                                    Binding="{Binding AliquotaIvaLabel}"
                                    Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Editor inline (overlay) -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                IsVisible="{Binding EditorAperto}"
                Background="#80000000">
            <Border Background="{DynamicResource SystemRegionBrush}"
                    CornerRadius="10" Padding="24"
                    Width="420" MaxWidth="420"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding EditorTitolo}"
                               FontSize="18" FontWeight="SemiBold" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Nome *" FontWeight="SemiBold" Opacity="0.8" />
                        <TextBox Text="{Binding EditNome}"
                                 Watermark="es. Materiali, Servizi…" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="IVA predefinita" FontWeight="SemiBold" Opacity="0.8" />
                        <ComboBox ItemsSource="{Binding AliquoteImponibili}"
                                  SelectedItem="{Binding EditAliquota}"
                                  PlaceholderText="— nessuna (usa IVA prodotto) —"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:AliquotaIva">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding Valore, StringFormat='{}{0:0.##}%'}" />
                                        <TextBlock Text="—" Opacity="0.5" />
                                        <TextBlock Text="{Binding Nome}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Applicata ai nuovi prodotti creati in questa categoria."
                                   Opacity="0.6" FontSize="12" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="8" Margin="0,8,0,0">
                        <Button Content="Annulla" Command="{Binding AnnullaCommand}" />
                        <Button Content="Salva" Command="{Binding SalvaCommand}" Classes="accent" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>

</UserControl>
