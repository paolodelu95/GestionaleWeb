<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Ordeva.Desktop.Views.LavagnaView"
             x:DataType="vm:LavagnaViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Intestazione + azioni -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Lavagna" FontSize="28" FontWeight="Bold" />
                <TextBlock Foreground="#64748B" FontSize="13">
                    <Run Text="{Binding TotaleCount}" /><Run Text=" post-it · " /><Run
                        Text="{Binding AttiviCount}" /><Run Text=" attivi · " /><Run
                        Text="{Binding RidottiCount}" /><Run Text=" ridotti" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Cambia tipo" Command="{Binding SetTipoCommand}" CommandParameter="elenco" />
                <Button Content="Colore" Command="{Binding CambiaColoreCommand}" />
                <Button Content="Riduci/ripristina" Command="{Binding ToggleRidottoCommand}" />
                <Button Content="Modifica" Command="{Binding ModificaCommand}" />
                <Button Content="Nuovo post-it" Command="{Binding AggiungiCommand}" Classes="accent" />
            </StackPanel>
        </Grid>

        <!-- Barra selezione multipla / eliminazione in blocco -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8"
                Background="#FFF1F2" CornerRadius="8"
                IsVisible="{Binding HasSelezione}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding NumSelezionati, StringFormat='{}{0} selezionati'}" />
                <Button Content="Elimina selezionati" Command="{Binding EliminaCommand}"
                        Foreground="#DC2626" />
            </StackPanel>
        </Border>

        <!-- Ricerca + filtri -->
        <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBox Grid.Column="0" Watermark="Cerca post-it..."
                     Text="{Binding Ricerca, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="150"
                      PlaceholderText="Tutti i tipi"
                      ItemsSource="{Binding Tipi}"
                      SelectedItem="{Binding FiltroTipo, Mode=TwoWay}" />
            <ToggleButton Grid.Column="2" Margin="8,0,0,0" Content="Nascondi ridotti"
                          IsChecked="{Binding NascondiRidotti, Mode=TwoWay}" />
            <Button Grid.Column="3" Margin="8,0,0,0" Content="Azzera filtri"
                    Command="{Binding ResetFiltriCommand}" />
        </Grid>

        <!-- Spaziatore vuoto per coerenza griglia (riga 3) -->
        <Border Grid.Row="3" Height="0" />

        <!-- Tabella post-it -->
        <Border Grid.Row="4" Margin="0,12,0,0" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Note}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Titolo" Binding="{Binding TitoloLabel}" Width="2*" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoLabel}" Width="Auto" />
                    <DataGridTextColumn Header="Contenuto" Binding="{Binding Anteprima}" Width="3*" />
                    <DataGridTextColumn Header="Colore" Binding="{Binding Colore}" Width="Auto" />
                    <DataGridTextColumn Header="Stato" Binding="{Binding StatoLabel}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
