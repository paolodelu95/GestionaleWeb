<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             xmlns:models="clr-namespace:Ordeva.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="Ordeva.Desktop.Views.PagamentoView"
             x:DataType="vm:PagamentoViewModel">

    <Grid ColumnDefinitions="*,Auto">

        <!-- ── Colonna principale ─────────────────────────────────────────── -->
        <DockPanel Grid.Column="0" Margin="24">

            <!-- Intestazione + azioni -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Pagamenti" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Registro incassi e pagamenti, con scadenzario dei documenti."
                               Opacity="0.6" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="Modifica"
                            IsVisible="{Binding MostraPagamenti}"
                            Command="{Binding ModificaCommand}" />
                    <Button Content="Elimina" Foreground="#DC2626"
                            IsVisible="{Binding MostraPagamenti}"
                            Command="{Binding EliminaCommand}" />
                    <Button Content="Nuovo pagamento"
                            Command="{Binding AggiungiCommand}"
                            Classes="accent" />
                </StackPanel>
            </Grid>

            <!-- Selettore vista -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <TextBlock Text="Vista:" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox MinWidth="160"
                          ItemsSource="{Binding Viste}"
                          SelectedItem="{Binding VistaSelezionata}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VistaOption">
                            <TextBlock Text="{Binding Etichetta}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Barra filtri -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*" Margin="0,0,0,12">
                <ComboBox Grid.Column="0" MinWidth="120"
                          PlaceholderText="Tutti gli anni"
                          ItemsSource="{Binding Anni}"
                          SelectedItem="{Binding FiltroAnno}" />
                <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="100"
                          PlaceholderText="Tutti i mesi"
                          ItemsSource="{Binding Mesi}"
                          SelectedItem="{Binding FiltroMese}" />
                <ComboBox Grid.Column="2" Margin="8,0,0,0" MinWidth="200"
                          PlaceholderText="Tutte le controparti"
                          ItemsSource="{Binding Controparti}"
                          SelectedItem="{Binding FiltroControparte}" />
                <Button Grid.Column="3" Margin="8,0,0,0" Content="Azzera filtri"
                        Command="{Binding ResetFiltriCommand}" />
                <Button Grid.Column="4" Content="Ricarica" HorizontalAlignment="Right"
                        Command="{Binding CaricaCommand}" />
            </Grid>

            <!-- Barra saldo multiplo (solo scadenzario con selezione) -->
            <Border DockPanel.Dock="Top"
                    IsVisible="{Binding HasSelezione}"
                    Background="#ECFEFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding NumSelezionati, StringFormat='{}{0} voci selezionate'}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding TotaleSelezionato, StringFormat='Totale: {0:C2}'}" />
                    <Button Content="Salda selezionati" Classes="accent"
                            Command="{Binding SaldaSelezionatiCommand}" />
                </StackPanel>
            </Border>

            <!-- Riepiloghi -->
            <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12,8"
                    Background="#F1F5F9" CornerRadius="8" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding MostraPagamenti}">
                        <TextBlock Text="Entrate:" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotaleEntrate, StringFormat='{}{0:C2}'}" Foreground="#15803D" VerticalAlignment="Center" />
                        <TextBlock Text="Uscite:" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotaleUscite, StringFormat='{}{0:C2}'}" Foreground="#DC2626" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding MostraScadenzario}">
                        <TextBlock Text="Da incassare:" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DaSaldareEntrate, StringFormat='{}{0:C2}'}" Foreground="#15803D" VerticalAlignment="Center" />
                        <TextBlock Text="Da pagare:" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DaSaldareUscite, StringFormat='{}{0:C2}'}" Foreground="#DC2626" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tabella movimenti -->
            <DataGrid Name="GrigliaPagamenti"
                      IsVisible="{Binding MostraPagamenti}"
                      ItemsSource="{Binding Pagamenti}"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="6">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Width="110" Binding="{Binding DataPagamento}" />
                    <DataGridTextColumn Header="Tipo" Width="90" Binding="{Binding Tipo}" />
                    <DataGridTextColumn Header="Importo" Width="120"
                                        Binding="{Binding Importo, StringFormat='{}{0:C2}'}" />
                    <DataGridTextColumn Header="Documento" Width="140" Binding="{Binding DocumentoLabel}" />
                    <DataGridTextColumn Header="Controparte" Width="*" Binding="{Binding Controparte}" />
                    <DataGridTextColumn Header="Metodo" Width="140" Binding="{Binding TipoPagamentoNome}" />
                    <DataGridTextColumn Header="Conto" Width="90" Binding="{Binding Conto}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Tabella scadenzario -->
            <DataGrid Name="GrigliaScadenzario"
                      IsVisible="{Binding MostraScadenzario}"
                      ItemsSource="{Binding Scadenzario}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="6">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tipo" Width="100" Binding="{Binding TipoEntry}" />
                    <DataGridTextColumn Header="Numero" Width="120" Binding="{Binding Numero}" />
                    <DataGridTextColumn Header="Emissione" Width="110" Binding="{Binding DataEmissione}" />
                    <DataGridTextColumn Header="Scadenza" Width="110" Binding="{Binding DataScadenza}" />
                    <DataGridTextColumn Header="Controparte" Width="*" Binding="{Binding Controparte}" />
                    <DataGridTextColumn Header="Totale" Width="120"
                                        Binding="{Binding ImportoTotale, StringFormat='{}{0:C2}'}" />
                    <DataGridTextColumn Header="Rimanente" Width="120"
                                        Binding="{Binding Rimanente, StringFormat='{}{0:C2}'}" />
                    <DataGridTemplateColumn Header="" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:ScadenzarioEntry">
                                <Button Content="Salda" Classes="accent" VerticalAlignment="Center"
                                        Command="{Binding $parent[DataGrid].((vm:PagamentoViewModel)DataContext).SaldaCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- ── Pannello editor movimento ──────────────────────────────────── -->
        <Border Grid.Column="1"
                IsVisible="{Binding EditorAperto}"
                Width="380"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
            <StackPanel Margin="24" Spacing="14">
                <TextBlock Text="{Binding TitoloEditor}" FontSize="18" FontWeight="Bold" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Data *" FontWeight="SemiBold" FontSize="13" />
                    <TextBox Text="{Binding EditDataPagamento}" Watermark="aaaa-mm-gg" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Importo *" FontWeight="SemiBold" FontSize="13" />
                    <NumericUpDown Value="{Binding EditImporto}" Minimum="0" Increment="1"
                                   FormatString="0.00" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Tipo" FontWeight="SemiBold" FontSize="13" />
                    <ComboBox ItemsSource="{Binding Tipi}"
                              SelectedItem="{Binding EditTipo}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Metodo di pagamento" FontWeight="SemiBold" FontSize="13" />
                    <ComboBox ItemsSource="{Binding TipiPagamento}"
                              SelectedItem="{Binding EditTipoPagamento}"
                              PlaceholderText="— nessuno —"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TipoPagamento">
                                <TextBlock Text="{Binding Nome}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Il conto (banca/cassa) viene impostato in automatico."
                               Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Causale" FontWeight="SemiBold" FontSize="13" />
                    <TextBox Text="{Binding EditCausale}" Watermark="(facoltativa)" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Fattura collegata" FontWeight="SemiBold" FontSize="13" />
                    <ComboBox ItemsSource="{Binding Fatture}"
                              SelectedItem="{Binding EditFattura}"
                              PlaceholderText="— nessuna —"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Fattura">
                                <TextBlock Text="{Binding Numero}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Note" FontWeight="SemiBold" FontSize="13" />
                    <TextBox Text="{Binding EditNote}" AcceptsReturn="True" Height="60"
                             TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock IsVisible="{Binding ErroreEditor, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding ErroreEditor}"
                           Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Annulla" Command="{Binding AnnullaCommand}" />
                    <Button Content="Salva" Classes="accent" Command="{Binding SalvaCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Pannello saldo (sopra l'editor, sola colonna 1) ────────────── -->
        <Border Grid.Column="1"
                IsVisible="{Binding SaldoAperto}"
                Width="380"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
            <StackPanel Margin="24" Spacing="14">
                <TextBlock Text="{Binding TitoloSaldo}" FontSize="18" FontWeight="Bold" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Importo *" FontWeight="SemiBold" FontSize="13" />
                    <NumericUpDown Value="{Binding SaldoImporto}" Minimum="0" Increment="1"
                                   FormatString="0.00" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Data saldo *" FontWeight="SemiBold" FontSize="13" />
                    <TextBox Text="{Binding SaldoData}" Watermark="aaaa-mm-gg" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Metodo di pagamento" FontWeight="SemiBold" FontSize="13" />
                    <ComboBox ItemsSource="{Binding TipiPagamento}"
                              SelectedItem="{Binding SaldoTipoPagamento}"
                              PlaceholderText="— nessuno —"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TipoPagamento">
                                <TextBlock Text="{Binding Nome}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <TextBlock IsVisible="{Binding ErroreSaldo, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Text="{Binding ErroreSaldo}"
                           Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Annulla" Command="{Binding AnnullaSaldoCommand}" />
                    <Button Content="Conferma saldo" Classes="accent" Command="{Binding ConfermaSaldoCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
