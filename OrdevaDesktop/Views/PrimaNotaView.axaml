<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             xmlns:models="clr-namespace:Ordeva.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="Ordeva.Desktop.Views.PrimaNotaView"
             x:DataType="vm:PrimaNotaViewModel">

    <Grid ColumnDefinitions="*,Auto">

        <!-- ── Colonna principale: riepilogo + lista ──────────────────────────── -->
        <DockPanel Grid.Column="0" Margin="24">

            <!-- Intestazione -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Prima Nota" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Movimenti di cassa e banca: entrate e uscite."
                               Opacity="0.6" FontSize="13" />
                </StackPanel>
                <Button Grid.Column="1" Content="Nuova registrazione"
                        Command="{Binding AggiungiCommand}"
                        VerticalAlignment="Center"
                        Classes="accent" />
            </Grid>

            <!-- Riepilogo entrate / uscite / saldo -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*" Margin="0,0,0,16">
                <Border Grid.Column="0" Background="#ECFDF5" CornerRadius="8"
                        Padding="14" Margin="0,0,8,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Entrate" FontSize="12" Opacity="0.7" />
                        <TextBlock Text="{Binding TotaleEntrate, StringFormat='{}{0:C2}'}"
                                   FontSize="20" FontWeight="Bold" Foreground="#047857" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#FEF2F2" CornerRadius="8"
                        Padding="14" Margin="8,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Uscite" FontSize="12" Opacity="0.7" />
                        <TextBlock Text="{Binding TotaleUscite, StringFormat='{}{0:C2}'}"
                                   FontSize="20" FontWeight="Bold" Foreground="#DC2626" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#F0F9FF" CornerRadius="8"
                        Padding="14" Margin="8,0,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Saldo" FontSize="12" Opacity="0.7" />
                        <TextBlock Text="{Binding Saldo, StringFormat='{}{0:C2}'}"
                                   FontSize="20" FontWeight="Bold" Foreground="#11769b" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Barra ricerca / filtri -->
            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
                <TextBox Grid.Column="0"
                         Text="{Binding Ricerca}"
                         Watermark="Cerca per causale, note o conto…"
                         MaxWidth="320" HorizontalAlignment="Left" />
                <ComboBox Grid.Column="1" Width="150" Margin="12,0,0,0"
                          ItemsSource="{Binding Mesi}"
                          SelectedItem="{Binding FiltroMese}"
                          VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" Width="120" Margin="8,0,0,0"
                          ItemsSource="{Binding FiltroConti}"
                          SelectedItem="{Binding FiltroConto}"
                          VerticalAlignment="Center" />
                <ComboBox Grid.Column="3" Width="120" Margin="8,0,0,0"
                          ItemsSource="{Binding FiltroTipi}"
                          SelectedItem="{Binding FiltroTipo}"
                          VerticalAlignment="Center" />
                <Button Grid.Column="4" Content="Azzera filtri"
                        Command="{Binding ResetFiltriCommand}"
                        Margin="8,0,0,0" VerticalAlignment="Center" />
                <Button Grid.Column="5" Content="Ricarica"
                        Command="{Binding LoadCommand}"
                        Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <!-- Barra azioni di blocco (solo con selezione) -->
            <Border DockPanel.Dock="Top"
                    IsVisible="{Binding EliminaSelezionatiCommand.CanExecute}"
                    Background="#FFF1F0" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding NumeroSelezionati, StringFormat='{}{0} selezionati'}" />
                    <Button Content="Elimina selezionati"
                            Command="{Binding EliminaSelezionatiCommand}"
                            Foreground="#DC2626" />
                </StackPanel>
            </Border>

            <!-- Tabella -->
            <DataGrid Name="Griglia"
                      ItemsSource="{Binding Items}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="6">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Width="110"
                                        Binding="{Binding Data}" />
                    <DataGridTextColumn Header="Tipo" Width="90"
                                        Binding="{Binding TipoLabel}" />
                    <DataGridTextColumn Header="Causale" Width="*"
                                        Binding="{Binding Causale}" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Conto" Width="90"
                                        Binding="{Binding Conto}" />
                    <DataGridTextColumn Header="Importo" Width="120"
                                        Binding="{Binding Importo, StringFormat='{}{0:C2}'}" />
                    <DataGridTextColumn Header="Note" Width="200"
                                        Binding="{Binding Note}" />
                    <DataGridTemplateColumn Header="" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:PrimaNota">
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <Button Content="Modifica"
                                            Command="{Binding $parent[DataGrid].((vm:PrimaNotaViewModel)DataContext).ModificaCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Elimina"
                                            Foreground="#DC2626"
                                            Command="{Binding $parent[DataGrid].((vm:PrimaNotaViewModel)DataContext).EliminaCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- ── Pannello editor laterale ───────────────────────────────────────── -->
        <Border Grid.Column="1"
                IsVisible="{Binding EditorAperto}"
                Width="360"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
            <StackPanel Margin="24" Spacing="14">
                <TextBlock Text="{Binding TitoloEditor}"
                           FontSize="18" FontWeight="Bold" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Data *" FontWeight="SemiBold" FontSize="13" />
                    <DatePicker SelectedDate="{Binding EditData}"
                                HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Tipo *" FontWeight="SemiBold" FontSize="13" />
                    <ComboBox ItemsSource="{Binding Tipi}"
                              SelectedItem="{Binding EditTipo}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Causale *" FontWeight="SemiBold" FontSize="13" />
                    <TextBox Text="{Binding EditCausale}"
                             Watermark="Es. Incasso fattura, Pagamento fornitore…" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Importo (€) *" FontWeight="SemiBold" FontSize="13" />
                    <NumericUpDown Value="{Binding EditImporto}"
                                   Minimum="0" Increment="1"
                                   FormatString="0.00" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Conto *" FontWeight="SemiBold" FontSize="13" />
                    <ComboBox ItemsSource="{Binding Conti}"
                              SelectedItem="{Binding EditConto}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Note" FontWeight="SemiBold" FontSize="13" />
                    <TextBox Text="{Binding EditNote}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                             Watermark="Annotazioni opzionali" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Annulla" Command="{Binding AnnullaCommand}" />
                    <Button Content="Salva" Classes="accent"
                            Command="{Binding SalvaCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
