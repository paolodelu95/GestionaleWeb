<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Ordeva.Desktop.Views.AppuntamentoView"
             x:DataType="vm:AppuntamentoViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Intestazione + azioni -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Agenda" FontSize="28" FontWeight="Bold" />
                <TextBlock Opacity="0.6" FontSize="13" Margin="0,2,0,0"
                           Text="{Binding TotaleAppuntamenti, StringFormat='{}{0} appuntamenti'}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Modifica" Command="{Binding ModificaCommand}" />
                <Button Content="Nuovo appuntamento" Command="{Binding AggiungiCommand}"
                        Classes="accent" />
            </StackPanel>
        </Grid>

        <!-- Messaggio (errore / esito) -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,8"
                Background="#FFF1F2" CornerRadius="8"
                IsVisible="{Binding Messaggio, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Messaggio}" Foreground="#B91C1C" TextWrapping="Wrap" />
        </Border>

        <!-- Barra selezione multipla: eliminazione e cambio stato in blocco -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,8"
                Background="#FEF3C7" CornerRadius="8"
                IsVisible="{Binding HasSelezione}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="{Binding NumSelezionati, StringFormat='{}{0} selezionati'}" />
                <Button Content="Segna completati" Command="{Binding CompletaCommand}"
                        Foreground="#16A34A" />
                <Button Content="Annulla" Command="{Binding AnnullaCommand}"
                        Foreground="#F59E0B" />
                <Button Content="Elimina selezionati" Command="{Binding EliminaCommand}"
                        Foreground="#DC2626" />
            </StackPanel>
        </Border>

        <!-- Ricerca + filtro stato -->
        <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto">
            <TextBox Grid.Column="0" Watermark="Cerca per titolo, note, luogo, controparte..."
                     Text="{Binding Ricerca, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" Width="180"
                      ItemsSource="{Binding StatiFiltro}"
                      SelectedItem="{Binding FiltroStato, Mode=TwoWay}"
                      PlaceholderText="Tutti gli stati" />
            <Button Grid.Column="2" Margin="8,0,0,0" Content="Azzera filtri"
                    Command="{Binding ResetFiltriCommand}" />
        </Grid>

        <!-- Tabella appuntamenti -->
        <Border Grid.Row="4" Margin="0,12,0,0" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Appuntamenti}"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Inizio" Binding="{Binding Inizio}" Width="Auto" />
                    <DataGridTextColumn Header="Fine" Binding="{Binding Fine}" Width="Auto" />
                    <DataGridTextColumn Header="Titolo" Binding="{Binding Titolo}" Width="2*" />
                    <DataGridTextColumn Header="Luogo" Binding="{Binding Luogo}" Width="*" />
                    <DataGridTextColumn Header="Controparte" Binding="{Binding Controparte}" Width="2*" />
                    <DataGridTextColumn Header="Stato" Binding="{Binding Stato}" Width="Auto" />
                    <DataGridTextColumn Header="Promemoria (min)" Binding="{Binding Promemoria}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
