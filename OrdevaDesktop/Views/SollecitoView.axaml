<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="640"
             x:Class="Ordeva.Desktop.Views.SollecitoView"
             x:DataType="vm:SollecitoViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,*">

        <!-- Intestazione (registro di sola lettura: solo Aggiorna) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Solleciti di pagamento"
                           FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Storico degli avvisi inviati (sola lettura)"
                           Foreground="#64748B" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Aggiorna" Command="{Binding CaricaCommand}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Ricerca + filtri (entità / esito / intervallo date) -->
        <Grid Grid.Row="1" Margin="0,12,0,0"
              ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
            <TextBox Grid.Column="0" Watermark="Cerca per documento, controparte, email..."
                     Text="{Binding Ricerca, Mode=TwoWay}" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="140"
                      PlaceholderText="Tutti i tipi"
                      ItemsSource="{Binding Tipi}"
                      SelectedItem="{Binding FiltroTipo, Mode=TwoWay}" />
            <ComboBox Grid.Column="2" Margin="8,0,0,0" MinWidth="140"
                      PlaceholderText="Tutti gli esiti"
                      ItemsSource="{Binding Esiti}"
                      SelectedItem="{Binding FiltroEsito, Mode=TwoWay}" />
            <TextBox Grid.Column="3" Margin="8,0,0,0" Width="130"
                     Watermark="Dal (AAAA-MM-GG)"
                     Text="{Binding DataDa, Mode=TwoWay}" />
            <TextBox Grid.Column="4" Margin="8,0,0,0" Width="130"
                     Watermark="Al (AAAA-MM-GG)"
                     Text="{Binding DataA, Mode=TwoWay}" />
            <Button Grid.Column="5" Margin="8,0,0,0" Content="Azzera filtri"
                    Command="{Binding ResetFiltriCommand}" />
        </Grid>

        <!-- Tabella solleciti (sola lettura) -->
        <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="8"
                BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="Grid"
                      ItemsSource="{Binding Solleciti}"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding DataInvio}" Width="Auto" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding DocumentoTipoLabel}" Width="Auto" />
                    <DataGridTextColumn Header="Documento" Binding="{Binding DocumentoRiferimento}" Width="*" />
                    <DataGridTextColumn Header="Controparte" Binding="{Binding Controparte}" Width="2*" />
                    <DataGridTextColumn Header="Destinatario" Binding="{Binding EmailDestinatario}" Width="2*" />
                    <DataGridTextColumn Header="Esito" Binding="{Binding Esito}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
