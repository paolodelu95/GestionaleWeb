<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ordeva.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
             x:Class="Ordeva.Desktop.Views.NotaRapidaView"
             x:DataType="vm:NotaRapidaViewModel">

    <Grid Margin="24" RowDefinitions="Auto,Auto,*">

        <!-- Intestazione -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Note rapide" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Appaiono nel menu &quot;Aggiungi nota&quot; di tutti i documenti (DDT, fatture, preventivi…)."
                           Opacity="0.6" FontSize="13" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Nuova nota"
                    Command="{Binding AggiungiCommand}"
                    VerticalAlignment="Center"
                    Classes="accent" />
        </Grid>

        <!-- Barra di ricerca + azioni di gruppo -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0"
                     Text="{Binding Ricerca}"
                     Watermark="Cerca per testo…"
                     MaxWidth="340" HorizontalAlignment="Left" />

            <Button Grid.Column="1" Content="Modifica"
                    Command="{Binding ModificaCommand}" Margin="8,0,0,0" />
            <Button Grid.Column="2" Content="Elimina"
                    Command="{Binding EliminaCommand}" Margin="8,0,0,0" />
            <Button Grid.Column="3" Content="Elimina selezionate"
                    Command="{Binding EliminaSelezionateCommand}" Margin="8,0,0,0" />
        </Grid>

        <!-- Griglia -->
        <DataGrid Grid.Row="2"
                  Name="Griglia"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding Selezionata}"
                  SelectionMode="Extended"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1" BorderBrush="#22000000"
                  CornerRadius="6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Testo"
                                    Binding="{Binding Testo}"
                                    Width="*" />
                <DataGridTextColumn Header="Ordine"
                                    Binding="{Binding Ordine}"
                                    Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Editor inline (overlay) -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                IsVisible="{Binding EditorAperto}"
                Background="#80000000">
            <Border Background="{DynamicResource SystemRegionBrush}"
                    CornerRadius="10" Padding="24"
                    Width="420" MaxWidth="420"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding EditorTitolo}"
                               FontSize="18" FontWeight="SemiBold" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Testo *" FontWeight="SemiBold" Opacity="0.8" />
                        <TextBox Text="{Binding EditTesto}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="80"
                                 Watermark="es. Merce resa, Pagamento contrassegno…" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Ordine" FontWeight="SemiBold" Opacity="0.8" />
                        <TextBox Text="{Binding EditOrdine}"
                                 Watermark="0" />
                        <TextBlock Text="Determina la posizione nel menu (numero crescente)."
                                   Opacity="0.6" FontSize="12" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="8" Margin="0,8,0,0">
                        <Button Content="Annulla" Command="{Binding AnnullaCommand}" />
                        <Button Content="Salva" Command="{Binding SalvaCommand}" Classes="accent" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>

</UserControl>
