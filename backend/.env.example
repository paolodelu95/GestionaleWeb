# ── Configurazione backend Ordeva ───────────────────────────────────────────
# Copia questo file in ".env" e compila i valori. Il file .env NON va committato.

# Porta del server (default 3000)
PORT=3000

# ── Modalità OFFLINE (edizione desktop/Electron, single-user) ────────────────
# Se "1": nessun login né multi-tenant. Ogni richiesta è autenticata come utente
# locale OWNER sul tenant "default"; trial/billing disattivati; AUTH_SECRET viene
# generato automaticamente se mancante. In questa modalità le variabili AUTH_* e
# CORS_ORIGIN qui sotto non servono.
OFFLINE_MODE=0

# Cartella dati (auth.db + tenants/*.db). Se vuota usa la cartella di default del
# backend. Nell'app Electron viene impostata automaticamente sulla userData.
# DATA_DIR=

# ── Modalità SaaS / multi-utente (ignorate se OFFLINE_MODE=1) ────────────────
# Segreto per firmare i token di sessione (obbligatorio fuori da OFFLINE_MODE).
# Genera un valore casuale, es:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Utente amministratore iniziale creato al primo avvio (se il DB è vuoto)
AUTH_USER=
AUTH_PASS=
# Origini ammesse per le richieste browser (CSV). Default: http://localhost:4200
# CORS_ORIGIN=http://localhost:4200

# ── Servizi esterni opzionali ────────────────────────────────────────────────
# OCR fatture (Mindee). Lascia vuoto per disattivare la funzione.
MINDEE_API_KEY=
